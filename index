<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard — CORVAL PHARMACEUTICAL</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --bg:#f8f4f4;
  --surface:#ffffff;
  --surface2:#fbefef;
  --border:rgba(240,82,82,0.15);
  --border-strong:rgba(240,82,82,0.35);
  --text:#3a2d2d;
  --text-2:#705a5a;
  --text-3:#ab8a8a;
  --brand:#F05252;
  --brand-dark:#c0392b;
  --brand-light:#fdeaea;
  --brand-xlight:#fff6f6;
  --gray:#4a4a4a;

  --blue-bg:#e8f0fb;   --blue-text:#1a4fa0;   --blue-border:#b5cef5;
  --teal-bg:#d6f0ee;   --teal-text:#2e9990;   --teal-border:#7dd4ce;
  --coral-bg:#faeae6;  --coral-text:#943819;  --coral-border:#f0b49e;
  --purple-bg:#eeecfe; --purple-text:#4e47b0; --purple-border:#c4bef8;
  --amber-bg:#faecd8;  --amber-text:#7e4c0a;  --amber-border:#f5c97a;
  --gray-bg:#f0eeea;   --gray-text:#5a5956;   --gray-border:#d0cec9;
  --green-bg:#e8f2da;  --green-text:#376010;  --green-border:#a9d175;
  --pink-bg:#fce8f0;   --pink-text:#8c1a4e;   --pink-border:#f0a8c8;

  --r-sm:6px; --r-md:10px; --r-lg:14px; --r-xl:18px;
}
body{font-family:'Raleway',Arial,sans-serif;background:var(--bg);color:var(--text);font-size:14px;line-height:1.6;min-height:100vh;}
.page{max-width:980px;margin:0 auto;padding:0 2rem 3rem;}

/* ── TOP BAR ── */
.topbar{background:var(--surface);border-bottom:1px solid var(--border);padding:0 2rem;margin:0 -2rem 2.5rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;height:64px;position:relative;}
.topbar::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--brand),var(--brand-dark));}
.logo-img{height:40px;width:auto;object-fit:contain;}
.logo-fallback{font-weight:700;letter-spacing:2px;color:var(--brand-dark);font-size:18px;display:none;}
.topbar-right{display:flex;align-items:center;gap:10px;}
.topbar-badge{font-size:11px;padding:4px 10px;border-radius:100px;background:var(--brand-light);color:var(--brand-dark);font-weight:600;}

/* ── HEADER ── */
.header{margin-bottom:2rem;animation:fadeUp .4s ease both;}
.breadcrumb{font-size:11px;color:var(--text-3);letter-spacing:.04em;margin-bottom:4px;display:flex;align-items:center;gap:5px;flex-wrap:wrap;}
.breadcrumb span{color:var(--brand);}
.main-title{font-size:30px;font-weight:700;letter-spacing:-.01em;line-height:1.1;color:var(--gray);margin-bottom:4px;}
.sub-title{font-size:13px;color:var(--text-2);}
.header-row{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap;}
.btn-drive{display:inline-flex;align-items:center;gap:7px;padding:9px 18px;background:var(--brand);border-radius:var(--r-md);font-size:13px;font-family:'Raleway',sans-serif;color:#fff;text-decoration:none;font-weight:600;transition:background .15s,transform .1s;}
.btn-drive:hover{background:var(--brand-dark);transform:translateY(-1px);}

/* ── INTRO BANNER ── */
.intro{background:linear-gradient(135deg,#fdeaea 0%,#fff6f6 100%);color:var(--text-2);border:1px solid var(--border);border-left:4px solid var(--brand);border-radius:var(--r-lg);padding:1.3rem 1.8rem;margin-bottom:2rem;font-size:14px;line-height:1.75;position:relative;overflow:hidden;animation:fadeUp .4s .03s ease both;}
.intro::after{content:'';position:absolute;right:-60px;top:-80px;width:240px;height:240px;border-radius:50%;background:rgba(240,82,82,.06);pointer-events:none;}
.intro p{position:relative;max-width:1080px;}
.intro p+p{margin-top:6px;}
.intro strong{color:var(--brand-dark);font-weight:700;}

/* ── STATS ── */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-bottom:2.5rem;animation:fadeUp .4s .05s ease both;}
.stat{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);padding:14px 16px;position:relative;overflow:hidden;transition:transform .15s,box-shadow .15s;}
.stat:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(58,45,45,.09);}
.stat::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--brand);}
.stat-label{font-size:11px;color:var(--text-3);margin-bottom:5px;text-transform:uppercase;letter-spacing:.04em;}
.stat-val{font-size:26px;font-weight:700;color:var(--brand-dark);line-height:1;}
.stat-val-sm{font-size:13px;font-weight:600;color:var(--text);padding-top:3px;}
.stat.s-blue::before{background:var(--blue-text);}     .stat.s-blue .stat-val,.stat.s-blue .stat-val-sm{color:var(--blue-text);}
.stat.s-brand::before{background:var(--brand);}        .stat.s-brand .stat-val,.stat.s-brand .stat-val-sm{color:var(--brand-dark);}
.stat.s-purple::before{background:var(--purple-text);} .stat.s-purple .stat-val,.stat.s-purple .stat-val-sm{color:var(--purple-text);}
.stat.s-amber::before{background:var(--amber-text);}   .stat.s-amber .stat-val,.stat.s-amber .stat-val-sm{color:var(--amber-text);}
.stat.s-teal::before{background:var(--teal-text);}     .stat.s-teal .stat-val,.stat.s-teal .stat-val-sm{color:var(--teal-text);}

/* ── SEC LABEL ── */
.sec-label{font-size:11px;font-weight:700;color:var(--brand-dark);text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.sec-label::before{content:'';display:inline-block;width:3px;height:14px;background:var(--brand);border-radius:2px;}
.divider{height:1px;background:var(--border);margin:2.5rem 0;}

/* ── FOLDER / REPO CARDS ── */
.folders-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-bottom:2.5rem;animation:fadeUp .4s .1s ease both;}
.fc{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:1.1rem 1.2rem;text-decoration:none;color:var(--text);display:block;transition:border-color .15s,box-shadow .15s,transform .15s;}
.fc:hover{border-color:var(--brand);box-shadow:0 4px 16px rgba(240,82,82,.12);transform:translateY(-2px);}
.fc-head{display:flex;align-items:center;gap:10px;margin-bottom:9px;}
.fc-icon{width:34px;height:34px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.fc-name{font-size:13px;font-weight:600;color:var(--gray);}
.fc-desc{font-size:12px;color:var(--text-2);line-height:1.55;margin-bottom:12px;}
.fc-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;}
.fc-url{font-family:'DM Mono',monospace;font-size:10.5px;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.arrow-lbl{font-size:11px;color:var(--brand);font-weight:600;white-space:nowrap;}
.repo-grid{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));}

/* ── BADGE ── */
.bdg{font-size:11px;padding:3px 9px;border-radius:100px;font-weight:600;display:inline-block;white-space:nowrap;}
.b-brand {background:var(--brand-light);color:var(--brand-dark);}
.b-blue  {background:var(--blue-bg);  color:var(--blue-text);}
.b-teal  {background:var(--teal-bg);  color:var(--teal-text);}
.b-coral {background:var(--coral-bg); color:var(--coral-text);}
.b-purple{background:var(--purple-bg);color:var(--purple-text);}
.b-amber {background:var(--amber-bg); color:var(--amber-text);}
.b-gray  {background:var(--gray-bg);  color:var(--gray-text);}
.b-green {background:var(--green-bg); color:var(--green-text);}
.b-pink  {background:var(--pink-bg);  color:var(--pink-text);}
.i-brand {background:var(--brand-light);}
.i-blue  {background:var(--blue-bg);}  .i-teal  {background:var(--teal-bg);}
.i-coral {background:var(--coral-bg);} .i-purple{background:var(--purple-bg);}
.i-amber {background:var(--amber-bg);}

/* ── META BAR ── */
.meta{background:var(--brand-xlight);border:1px solid var(--border);border-radius:var(--r-md);padding:10px 16px;margin-bottom:14px;display:flex;gap:20px;flex-wrap:wrap;}
.mi{font-size:12px;color:var(--text-2);}
.mi strong{color:var(--brand-dark);font-weight:600;}

/* ── ACCORDION ── */
.acc-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;flex-wrap:wrap;}
.acc-search{position:relative;flex:1;min-width:220px;max-width:360px;}
.acc-search svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--text-3);pointer-events:none;}
.acc-search input{width:100%;padding:8px 12px 8px 32px;border:1px solid var(--border-strong);border-radius:var(--r-md);font-family:'Raleway',sans-serif;font-size:12.5px;color:var(--text);background:var(--surface);transition:border-color .15s,box-shadow .15s;}
.acc-search input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px rgba(240,82,82,.15);}
.acc-toolbar-actions{display:flex;gap:8px;}
.acc-toggle-btn{font-size:11.5px;font-weight:600;color:var(--brand-dark);background:var(--brand-xlight);border:1px solid var(--border-strong);border-radius:var(--r-sm);padding:6px 12px;cursor:pointer;transition:background .15s,transform .1s;font-family:'Raleway',sans-serif;}
.acc-toggle-btn:hover{background:var(--brand-light);transform:translateY(-1px);}
.acc-group.is-hidden{display:none;}
.acc-no-results{display:none;font-size:12.5px;color:var(--text-3);padding:14px 4px;}
.acc-no-results.show{display:block;}
.acc-list{display:flex;flex-direction:column;gap:6px;margin-bottom:2rem;}
details.acc-group{border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden;transition:box-shadow .15s;}
details.acc-group[open]{box-shadow:0 2px 12px rgba(240,82,82,.1);}

summary.acc-header{
  display:flex;align-items:center;gap:10px;
  padding:12px 16px;cursor:pointer;user-select:none;
  background:var(--surface);
  border-left:4px solid transparent;
  list-style:none;
  transition:background .15s,filter .15s;
}
summary.acc-header:hover{filter:brightness(.96);}
summary.acc-header::-webkit-details-marker{display:none;}
details[open]>summary.acc-header{border-bottom:1px solid var(--border);}

.acc-code{font-family:'DM Mono',monospace;font-size:11px;font-weight:500;min-width:66px;}
.acc-name{font-size:13px;font-weight:600;flex:1;color:var(--gray);}
.acc-right{display:flex;align-items:center;gap:8px;margin-left:auto;flex-shrink:0;}
.acc-chevron{width:15px;height:15px;color:var(--text-3);transition:transform .2s;flex-shrink:0;}
details.acc-group[open]>summary .acc-chevron{transform:rotate(180deg);}

.acc-body{padding:14px 16px 14px 92px;background:var(--surface);}
.acc-dates{font-size:11px;color:var(--text-3);margin-bottom:10px;}
.acc-link{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;text-decoration:none;padding:6px 12px;border-radius:var(--r-sm);border:1px solid;transition:opacity .15s,transform .1s;}
.acc-link:hover{opacity:.8;transform:translateY(-1px);}
.acc-link svg{width:12px;height:12px;}
.acc-links{display:flex;gap:8px;flex-wrap:wrap;}
.acc-link.solid{color:#fff !important;background:var(--brand) !important;border-color:var(--brand) !important;}
.acc-note{font-size:11.5px;color:var(--amber-text);background:var(--amber-bg);border-radius:var(--r-sm);padding:6px 10px;margin-top:10px;display:inline-block;}

/* group color themes */
.fv-01>summary{border-left-color:#F05252;background:#fff6f6;}
.fv-02>summary{border-left-color:#943819;background:#faeae6;}
.fv-03>summary{border-left-color:#1a4fa0;background:#e8f0fb;}
.fv-04>summary{border-left-color:#7e4c0a;background:#faecd8;}
.fv-05>summary{border-left-color:#376010;background:#e8f2da;}
.fv-06>summary{border-left-color:#943819;background:#faeae6;}
.fv-07>summary{border-left-color:#1a4fa0;background:#e8f0fb;}
.fv-08>summary{border-left-color:#8c1a4e;background:#fce8f0;}
.fv-09>summary{border-left-color:#4e47b0;background:#eeecfe;}
.fv-10>summary{border-left-color:#376010;background:#e8f2da;}
.fv-11>summary{border-left-color:#F05252;background:#fff6f6;}
.fv-12>summary{border-left-color:#7e4c0a;background:#faecd8;}
.fv-13>summary{border-left-color:#4e47b0;background:#eeecfe;}
.fv-14>summary{border-left-color:#8c1a4e;background:#fce8f0;}

.fv-01 .acc-link,.fv-11 .acc-link{background:#fff6f6;color:#c0392b;border-color:#f5b8b8;}
.fv-02 .acc-link,.fv-06 .acc-link{background:#faeae6;color:#943819;border-color:#f0b49e;}
.fv-03 .acc-link,.fv-07 .acc-link{background:#e8f0fb;color:#1a4fa0;border-color:#b5cef5;}
.fv-04 .acc-link,.fv-12 .acc-link{background:#faecd8;color:#7e4c0a;border-color:#f5c97a;}
.fv-05 .acc-link,.fv-10 .acc-link{background:#e8f2da;color:#376010;border-color:#a9d175;}
.fv-08 .acc-link,.fv-14 .acc-link{background:#fce8f0;color:#8c1a4e;border-color:#f0a8c8;}
.fv-09 .acc-link,.fv-13 .acc-link{background:#eeecfe;color:#4e47b0;border-color:#c4bef8;}

/* sub-forms inside accordion */
.forms-table{width:100%;border-collapse:collapse;font-size:12px;margin-top:10px;}
.forms-table th{background:rgba(240,82,82,.07);color:var(--text-2);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.04em;padding:7px 10px;text-align:left;border-bottom:1px solid var(--border);}
.forms-table td{padding:8px 10px;border-bottom:1px solid rgba(240,82,82,.07);color:var(--text);vertical-align:top;line-height:1.5;}
.forms-table tr:last-child td{border-bottom:none;}
.forms-table tr:hover td{background:rgba(240,82,82,.04);}
.mono{font-family:'DM Mono',monospace;font-size:11px;color:var(--text-2);}
.form-link{color:var(--brand-dark);text-decoration:none;font-size:12px;}
.form-link:hover{text-decoration:underline;}

/* ── COURSES ── */
.courses-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-bottom:2rem;}
.course-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:1.2rem 1.4rem;text-decoration:none;color:var(--text);display:flex;flex-direction:column;gap:10px;transition:border-color .15s,box-shadow .15s,transform .15s;}
.course-card:hover{border-color:var(--brand);box-shadow:0 4px 20px rgba(240,82,82,.15);transform:translateY(-2px);}
.course-tag{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;color:var(--brand-dark);background:var(--brand-xlight);padding:3px 10px;border-radius:100px;width:fit-content;}
.course-title{font-size:14px;font-weight:700;color:var(--gray);line-height:1.4;}
.course-desc{font-size:12px;color:var(--text-2);line-height:1.55;flex:1;}
.course-footer{display:flex;align-items:center;justify-content:space-between;margin-top:4px;}
.course-platform{font-size:11px;color:var(--text-3);}
.course-cta{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;color:#fff;background:var(--brand);padding:6px 14px;border-radius:var(--r-sm);transition:background .15s;}
.course-card:hover .course-cta{background:var(--brand-dark);}

/* ── SECTION ACCORDION (top-level) ── */
details.sec-acc{border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden;margin-bottom:1rem;}
details.sec-acc[open]{box-shadow:0 2px 16px rgba(240,82,82,.1);}
summary.sec-acc-header{display:flex;align-items:center;gap:10px;padding:14px 18px;cursor:pointer;user-select:none;background:var(--brand-xlight);border-left:4px solid var(--brand);list-style:none;transition:background .15s;}
summary.sec-acc-header::-webkit-details-marker{display:none;}
details.sec-acc[open]>summary.sec-acc-header{border-bottom:1px solid var(--border);}
.sec-acc-icon{width:30px;height:30px;border-radius:var(--r-sm);background:var(--brand-light);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.sec-acc-title{font-size:13px;font-weight:700;color:var(--brand-dark);flex:1;text-transform:uppercase;letter-spacing:.04em;}
.sec-acc-sub{font-size:11px;color:var(--text-2);font-weight:400;text-transform:none;letter-spacing:0;}
.sec-acc-chevron{width:16px;height:16px;color:var(--brand);transition:transform .2s;flex-shrink:0;}
details.sec-acc[open] .sec-acc-chevron{transform:rotate(180deg);}
.sec-acc-body{padding:1.5rem 1.5rem 1rem;}

/* ── GAMP TABLE ── */
.tbl-wrap{overflow-x:auto;margin-bottom:2rem;}
table.gamp{width:100%;border-collapse:collapse;font-size:12px;}
table.gamp thead th{background:var(--brand-xlight);color:var(--brand-dark);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.05em;padding:10px 12px;text-align:left;border-bottom:2px solid var(--brand-light);}
table.gamp tbody td{padding:10px 12px;border-bottom:1px solid var(--border);color:var(--text);vertical-align:top;line-height:1.55;}
table.gamp tbody tr:last-child td{border-bottom:none;}
table.gamp tbody tr:hover td{background:var(--brand-xlight);}
.td-strong{font-weight:600;color:var(--gray);}
.ck{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;background:var(--green-bg);border-radius:4px;font-size:10px;color:var(--green-text);font-weight:600;}
.cx{display:inline-flex;align-items:center;justify-content:center;width:auto;padding:0 4px;height:18px;background:var(--amber-bg);border-radius:4px;font-size:10px;color:var(--amber-text);font-weight:600;}

/* ── FOOTER ── */
footer{margin-top:2.5rem;border-top:2px solid var(--brand-light);padding:1.5rem 0 2.5rem;}
.foot-title{font-size:10px;font-weight:700;color:var(--brand-dark);text-transform:uppercase;letter-spacing:.09em;margin-bottom:8px;display:flex;align-items:center;gap:8px;}
.foot-title::before{content:'';display:inline-block;width:14px;height:14px;background:var(--brand-light);border-radius:3px;flex-shrink:0;}
.foot-text{font-size:11.5px;color:var(--text-3);line-height:1.85;max-width:860px;}
.foot-contact{font-size:11.5px;color:var(--text-2);margin-top:12px;display:flex;gap:18px;flex-wrap:wrap;}
.foot-contact a{color:var(--brand-dark);text-decoration:none;}
.foot-source{font-size:10.5px;color:var(--text-3);margin-top:10px;font-style:italic;opacity:.75;}

@keyframes fadeUp{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
@media(max-width:600px){.intro{padding:1.1rem 1.2rem;font-size:13px;}.page{padding:0 1rem 2rem;}.main-title{font-size:22px;}.header-row{flex-direction:column;align-items:stretch;}.btn-drive{width:100%;justify-content:center;}.topbar{padding:0 1rem;margin:0 -1rem 2rem;}.topbar-badge{font-size:10px;}.acc-body{padding:12px 12px 12px 14px;}}
</style>
</head>
<body>

<div class="page">

<!-- TOP BAR -->
<div class="topbar">
  <a href="https://www.corval.com.pe/" style="display:flex;align-items:center;text-decoration:none;">
    <img class="logo-img" src="logo.png" alt="CORVAL Pharmaceutical S.A.C." onerror="this.style.display='none';this.nextElementSibling.style.display='inline';">
    <span class="logo-fallback">CORVAL</span>
  </a>
  <div class="topbar-right">
    <span class="topbar-badge">CORVAL PHARMACEUTICAL V1 (desarrollado por Conkomerco SAC)</span>
  </div>
</div>

  <!-- HEADER -->
  <div class="header">
    <div class="header-row">
      <div>
        <p class="breadcrumb">OneDrive <span>›</span> CORVAL FARMACOVIGILANCIA <span>›</span> Version 1</p>
        <h1 class="main-title">CORVAL PHARMACEUTICAL</h1>
        <p class="sub-title">Dashboard · Área de farmacovigilancia</p>
      </div>
      <a class="btn-drive" href="https://onedrive.live.com/shared?id=%2Fpersonal%2F69da2db12abed3d2%2FDocuments%2FCORVAL%20FARMACOVIGILANCIA%2FVersion%201&listurl=%2Fpersonal%2F69da2db12abed3d2%2FDocuments&viewid=c9c16975%2D4195%2D42cb%2Dbabb%2D671f1bda5e0d&ithint=folder&migratedtospo=true&ga=1" target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/></svg>
        Abrir en OneDrive ↗
      </a>
    </div>
